{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "theme.schema.json",
  "title": "Quiz theme",
  "type": "object",
  "properties": {
    "scheme": {
      "enum": [
        "dark",
        "light"
      ]
    },
    "accent": {
      "type": "string",
      "description": "hex, rgb(), hsl() or oklch()"
    },
    "accentSecondary": {
      "type": "string"
    },
    "bgPrimary": {
      "type": "string"
    },
    "bgSurface": {
      "type": "string"
    },
    "fontSans": {
      "type": "string",
      "description": "CSS font-family list"
    },
    "fontMono": {
      "type": "string"
    },
    "radius": {
      "type": "string",
      "pattern": "^\\d+(\\.\\d+)?(px|rem|em)$"
    }
  },
  "additionalProperties": false
}
