{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "manifest.schema.json",
  "title": "Quiz manifest",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "author": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "topics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "anyOf": [
          {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "minLength": 1,
            "maxLength": 120
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.:-]+$",
                "minLength": 1,
                "maxLength": 120
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "title"
            ],
            "additionalProperties": false
          }
        ],
        "description": "a topic id, or {\"id\": \"...\", \"title\": \"...\"}"
      }
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "\\.(json|jsonl)$",
        "description": "path to a .json (array) or .jsonl file"
      }
    },
    "reference": {
      "type": "string",
      "pattern": "\\.(md|json)$"
    },
    "theme": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "\\.json$"
        },
        {
          "type": "object",
          "properties": {
            "scheme": {
              "enum": [
                "dark",
                "light"
              ]
            },
            "accent": {
              "type": "string",
              "description": "hex, rgb(), hsl() or oklch()"
            },
            "accentSecondary": {
              "type": "string"
            },
            "bgPrimary": {
              "type": "string"
            },
            "bgSurface": {
              "type": "string"
            },
            "fontSans": {
              "type": "string",
              "description": "CSS font-family list"
            },
            "fontMono": {
              "type": "string"
            },
            "radius": {
              "type": "string",
              "pattern": "^\\d+(\\.\\d+)?(px|rem|em)$"
            }
          },
          "additionalProperties": true
        }
      ],
      "description": "path to a theme .json, or an inline theme object"
    },
    "exam": {
      "type": "object",
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 1
        },
        "minutes": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  "required": [
    "title",
    "description",
    "topics",
    "questions"
  ],
  "additionalProperties": false
}
